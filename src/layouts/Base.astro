---
interface Props {
  title: string;
  description?: string;
  splash?: boolean;
}

const { title, description = 'Writing about complex trauma, family dynamics, and finding your own truth.', splash = false } = Astro.props;
const siteTitle = 'The Scapegoat Daughter';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} — ${siteTitle}`}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet" />

    <style>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    {!splash && (
      <header class="site-header">
        <div class="container">
          <a href="/" class="site-title">{siteTitle}</a>
          <nav class="site-nav">
            <a href="/journal">Journal</a>
            <a href="/about">About</a>
          </nav>
        </div>
      </header>
    )}

    <main class={splash ? '' : 'container'}>
      <slot />
    </main>

    {!splash && (
      <footer class="site-footer">
        <div class="container">
          &copy; {new Date().getFullYear()} {siteTitle}
        </div>
      </footer>
    )}
  </body>
</html>
