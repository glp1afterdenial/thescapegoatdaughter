---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;

// Estimate reading time from the raw slot content
const html = await Astro.slots.render('default');
const words = html.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 230));
---

<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={date.toISOString().slice(0, 10)}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      &nbsp;&middot;&nbsp;{readingTime} min read
    </p>
    <Fragment set:html={html} />
  </article>
  <a href="/essays" class="back-link">&larr; All Essays</a>
</Base>
