---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('essays'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Journal" description="All journal entries on complex trauma, family dynamics, and healing.">
  <h1 class="page-title">Journal</h1>
  {entries.length > 0 ? (
    <ul class="post-list">
      {entries.map((entry) => (
        <li class="post-item">
          <a href={`/journal/${entry.id}`}>
            <div class="post-title">{entry.data.title}</div>
            <div class="post-date">
              {entry.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </div>
            {entry.data.description && (
              <div class="post-description">{entry.data.description}</div>
            )}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p>Entries coming soon.</p>
  )}
</Base>
